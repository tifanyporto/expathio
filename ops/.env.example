# Template for the local development settings (ADR 0015).
#
# How to use:
#   1. Copy this file to ops/.env  (the copy is ignored by Git).
#   2. Put your own password after POSTGRES_PASSWORD=.
#   3. Never commit ops/.env, and never put a real password in this template.
#
# Keep the value on one line, with no spaces around "=".

# Name of the development database created inside the container.
POSTGRES_DB=expathio_dev

# Database user created inside the container.
POSTGRES_USER=expathio

# Choose a long, random password for the local database only.
POSTGRES_PASSWORD=

# Port on this Windows computer. 5432 is already used by the Windows
# PostgreSQL 16 service, so Docker uses 5433.
POSTGRES_HOST_PORT=5433
